{
  "name": "arbini.family",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm dev:web",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "pnpm test:env vitest",
    "test:run": "pnpm test:env vitest run",
    "prepare": "husky",
    "dev:web": "next dev",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local prisma/seed.ts",
    "prisma:initialize": "prisma generate && prisma migrate deploy",
    "postinstall": "prisma generate",
    "test:env": "dotenv -e .env -e .env.test -o --",
    "dev:email": "email dev --dir emails --port 3001",
    "env:cloud": "node scripts/env-cloud.mjs"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.2",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "~7.9.1",
    "@prisma/client": "~7.9.1",
    "better-auth": "1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.38.0",
    "next": "16.1.1",
    "pg": "~8.22.0",
    "postmark": "^5.1.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-email": "~6.9.0",
    "react-hook-form": "^7.87.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@react-email/ui": "~6.9.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20.19.28",
    "@types/pg": "~8.20.4",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.6.2",
    "prisma": "~7.9.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24 <25"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  }
}
