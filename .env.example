# Environment variables for arbini.family. Copy to .env.local and fill in.
#
# Tracked in git on purpose: .env.local is ignored, so this file is the only thing that tells a
# fresh clone what the app needs. Keep it in sync with lib/env/server.ts and lib/env/client.ts —
# values here are shape-only placeholders, never real secrets.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arbini_family

# The direct (unpooled) endpoint, read only by the Prisma CLI through prisma.config.ts — the app
# itself never reads it. `prisma migrate deploy` takes an advisory lock, which a transaction-mode
# pooler breaks by moving the next statement to a different backend. Unset here on purpose: the
# devcontainer's Postgres has no pooler, so the CLI falls back to DATABASE_URL. Set it in
# production, where DATABASE_URL is pooled.
DATABASE_URL_UNPOOLED=

# Comma-separated sign-in allowlist. Real addresses go in .env.local.
FAMILY_EMAILS=someone@example.com,someone-else@example.com

# The canonical origin. Passkey registration and the magic-link URLs are both built from it, and
# WebAuthn compares the origin byte-for-byte against what the browser used — so this must be the
# URL you type into the address bar, not necessarily the port the dev server binds.
APP_URL=http://localhost:3000

# Signs Better Auth session cookies. Generate with `openssl rand -hex 32`.
# Required in production; a development default is used when absent.
BETTER_AUTH_SECRET=

# Transactional email (Postmark). Both optional: with either missing, magic links are logged to
# the server console in development rather than sent, so sign-in stays exercisable without a token.
POSTMARK_API_TOKEN=
POSTMARK_FROM_EMAIL=

# --- Native app (passkeys) ---------------------------------------------------
# Both are only needed for passkeys, and only in an environment the app actually talks to. The
# association routes under /.well-known 404 while they are unset, which is the correct behaviour:
# the platform caches whatever it fetches, so serving a placeholder is worse than serving nothing.

# The 10-character Apple Developer Team ID (developer.apple.com → Membership).
APPLE_TEAM_ID=

# SHA-256 fingerprints of every Android signing certificate that will sign an installed build —
# debug, upload, and Play's re-signing key. Comma-separated, colon-delimited hex, as printed by
# `eas credentials` or `keytool -list -v`.
ANDROID_CERT_FINGERPRINTS=
