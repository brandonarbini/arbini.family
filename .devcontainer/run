#!/bin/bash
# Run commands inside the devcontainer
set -e

[ $# -eq 0 ] && { echo "Usage: $0 <command> [args...]" >&2; exit 1; }

# If already in container, run directly
[ -f /.dockerenv ] && exec "$@"

# On host - exec into container
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_DIR="$(dirname "$SCRIPT_DIR")"
WORKSPACE_NAME=$(basename "$WORKSPACE_DIR")
CONTAINER="${WORKSPACE_NAME}_devcontainer-app-1"

docker ps -q -f "name=^${CONTAINER}$" | grep -q . || {
  echo "Container $CONTAINER is not running. Start the devcontainer first." >&2
  exit 1
}

FLAGS="-w /workspaces/${WORKSPACE_NAME}"
[ -t 0 ] && [ -t 1 ] && FLAGS="-it $FLAGS"

docker exec $FLAGS "$CONTAINER" "$@"
