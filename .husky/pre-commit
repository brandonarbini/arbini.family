# Generated by dev-env (quality.format@1). Formatting is also gated in CI; this hook is
# the fast local path that fixes staged files instead of failing them.
#
# lint-staged rather than a bare `prettier --write` over the diff: it stashes unstaged work first,
# so a partially staged file cannot have its unstaged half silently swept into the commit.
#
# Skip cleanly when dependencies are not installed yet (fresh clone, mid-rebase tooling).
[ -x node_modules/.bin/lint-staged ] || exit 0
node_modules/.bin/lint-staged
