# Non-sensitive application defaults. Committed.
# Sensitive values go in .env.local (gitignored). See .env.example.

# The devcontainer runs PostgreSQL 17 on localhost and provisions no per-project database, so the
# datasource points at the `postgres` maintenance database. The Vitest harness never touches it:
# tool.prisma@3 clones its own template and per-worker databases from .env.test.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
