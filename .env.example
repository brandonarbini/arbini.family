# Environment variables for arbini.family. Copy to .env.local and fill in.
#
# Tracked in git on purpose: .env.local is ignored, so this file is the only thing that tells a
# fresh clone what the app needs. Keep it in sync with lib/env/server.ts and lib/env/client.ts —
# values here are shape-only placeholders, never real secrets.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arbini_family

# Comma-separated sign-in allowlist. Real addresses go in .env.local.
FAMILY_EMAILS=someone@example.com,someone-else@example.com
