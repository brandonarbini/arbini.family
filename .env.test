DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arbini_family_test?connection_limit=1

# The server env schema requires Postmark, so the suite needs values to parse at all. These are
# fakes: no test sends mail. Safe to commit and impossible to mask a production value with — only
# `test:env` loads this file.
POSTMARK_API_TOKEN=POSTMARK_API_TEST
POSTMARK_FROM_EMAIL=test@example.com
